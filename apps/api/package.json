{
  "name": "@cspad/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST CSPAD DJOUGOU (NestJS) — /api/v1",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js)",
