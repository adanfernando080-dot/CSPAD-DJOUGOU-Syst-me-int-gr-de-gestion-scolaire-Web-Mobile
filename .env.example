# ============================================================
# CSPAD DJOUGOU — variables d'environnement (EXEMPLE)
# Copier en .env puis adapter. Ne JAMAIS commiter .env ni un secret réel (§57).
# Staging/production : secrets injectés par la plateforme de déploiement.
# ============================================================

# --- API ---------------------------------------------------
# development | test | staging | production
APP_ENV=development
API_PORT=3001
# Origines autorisées (séparées par des virgules). Vide = CORS fermé.
API_CORS_ORIGINS=http://localhost:3000
API_BODY_LIMIT=1mb
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Swagger / OpenAPI : désactivé par défaut.
# En staging/production, SWAGGER_USER et SWAGGER_PASSWORD (16 caractères min.) sont obligatoires.
SWAGGER_ENABLED=true
SWAGGER_USER=
SWAGGER_PASSWORD=

# --- PostgreSQL (docker/docker-compose.dev.yml) -----------------
POSTGRES_DB=cspad_dev
POSTGRES_USER=cspad
POSTGRES_PASSWORD=changer-ce-mot-de-passe-local
POSTGRES_PORT=5432
# Utilisé par Prisma à partir de la Phase 2
DATABASE_URL=postgresql://cspad:changer-ce-mot-de-passe-local@localhost:5432/cspad_dev?schema=public

# --- Clients ------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# --- À venir (non utilisés en Phase 1) -------------------------
# Phase 2 : JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, durées de session, MFA
# Phase 3 : stockage S3 compatible (S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY)
